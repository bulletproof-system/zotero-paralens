{
  "name": "zotero-paralens",
  "type": "module",
  "version": "0.1.4",
  "description": "ParaLens：Zotero PDF 全文翻译与双语悬停对照",
  "config": {
    "addonName": "ParaLens",
    "addonID": "paralens@luotiantian.top",
    "addonRef": "paralens",
    "addonInstance": "ParaLens",
    "prefsPrefix": "extensions.zotero.paralens"
  },
  "author": "ltt",
  "homepage": "https://github.com/bulletproof-system/zotero-paralens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bulletproof-system/zotero-paralens.git"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "prestart": "node scripts/stage-backend.cjs",
    "start": "zotero-plugin serve",
    "prebuild": "node scripts/stage-backend.cjs",
    "build": "zotero-plugin build && tsc --noEmit && node scripts/verify-license-package.cjs",
    "verify:licenses": "node scripts/verify-license-package.cjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "prerelease": "node scripts/stage-backend.cjs",
    "release": "zotero-plugin release",
    "pretest": "node scripts/stage-backend.cjs",
    "test": "zotero-plugin test",
    "test:unit": "node --test test/*.test.cjs",
    "test:mapping": "node --test test/mapping-contract.test.cjs",
    "test:backend-settings": "node --test test/backend-settings.test.cjs",
    "test:babeldoc": "node --test test/babeldoc-backend.test.cjs test/backend-install.test.cjs",
    "update-deps": "npm update --save",
    "test:gui:isolated": "node scripts/gui-smoke-isolated.mjs"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "adm-zip": "^0.5.18",
    "eslint": "^9.39.5",
    "globals": "^14.0.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
